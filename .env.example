# =====================================================================
# ReviveAI Environment Configuration
# =====================================================================

# App Settings
APP_NAME=ReviveAI
APP_ENV=development
LOG_LEVEL=INFO
PORT=8000

# Database:
# Local SQLite (Default zero-config):
DATABASE_URL=sqlite+aiosqlite:///./reviveai.db
# Supabase PostgreSQL Async Connection (Uncomment and replace [PASSWORD]):
# DATABASE_URL=postgresql+asyncpg://postgres:[YOUR-PASSWORD]@db.ahufzfapqdjmwctwgcku.supabase.co:5432/postgres
# Or Session Pooler (port 6543):
# DATABASE_URL=postgresql+asyncpg://postgres.ahufzfapqdjmwctwgcku:[YOUR-PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres
SUPABASE_URL=https://ahufzfapqdjmwctwgcku.supabase.co
SUPABASE_KEY=

# Razorpay Test Mode Credentials (OPTIONAL for Sandbox Simulation)
# CRITICAL SAFETY NOTE: Only test keys (rzp_test_...) are accepted.
# The application will refuse to start if live keys (rzp_live_...) are configured.
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_test_secret_here
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_here

# AI Engine / Gemini Configuration (OPTIONAL - Heuristic fallback engaged if omitted)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Policy & Safety Guardrail Defaults
MAX_RETRIES_PER_CASE=3
MIN_HOURS_BETWEEN_RETRIES=24
AUTONOMOUS_AMOUNT_LIMIT_INR=50000.0
MIN_CONFIDENCE_THRESHOLD=0.65
MAX_CONTACT_ATTEMPTS=2
